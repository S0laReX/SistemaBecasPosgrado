@model SistemaBecasWeb.Models.ExperienciaViewModel

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">

            @if (TempData["Exito"] != null)
            {
                <div class="alert alert-success">@TempData["Exito"]</div>
            }

            <div class="card shadow-sm p-4">
                <h3 class="mb-3">Paso 2: Historial Laboral</h3>
                <p class="text-muted">Agregando experiencias para el postulante CI: <strong>@Model.DocIdentidad</strong></p>
                <hr />

                <form method="post" action="/Postulante/AgregarExperiencia">
                    <!-- Campo oculto para mandar el CI al controlador -->
                    <input type="hidden" name="DocIdentidad" value="@Model.DocIdentidad" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Empresa:</label>
                            <input type="text" name="Empresa" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label>Cargo Ocupado:</label>
                            <input type="text" name="Cargo" class="form-control" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Fecha de Inicio:</label>
                            <input type="date" name="FechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-4">
                            <label>Fecha de Finalización (Dejar vacío si aplica):</label>
                            <input type="date" name="FechaFin" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex justify-content-between">
                        <!-- El botón para seguir ciclando en la misma página -->
                        <button type="submit" class="btn btn-success">+ Agregar esta Experiencia</button>

                        <!-- El botón para ir finalmente al menú de postularse a la oferta -->
                        <a href="/Solicitud/Index" class="btn btn-secondary">Finalizar y Postular a Programa</a>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>
