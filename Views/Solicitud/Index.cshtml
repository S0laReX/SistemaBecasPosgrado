@{
    ViewData["Title"] = "Postular a un programa";
    int? ofertaSeleccionada = ViewBag.OfertaSeleccionada as int?;
}

<div class="container py-5">
    <h2 class="section-title">Postula a un programa</h2>
    <p class="section-subtitle">Completa tus datos para enviar tu postulacion a una convocatoria vigente.</p>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card-portal p-4">
                <h3 class="h5 mb-3">Datos de la postulacion</h3>
                <form method="post" action="/Solicitud/EnviarPostulacion">

                    <div class="mb-3">
                        <label class="form-label">Documento de identidad</label>
                        <input type="text" name="docIdentidad" class="form-control" required placeholder="Ej: 1234567" />
                        <div class="form-text">Debes haber creado tu perfil antes de postular. <a href="/Postulante/Crear">Crear mi perfil</a></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Programa al que deseas postular</label>
                        <select name="idOferta" class="form-select" required>
                            <option value="">-- Selecciona un programa --</option>
                            @if (ViewBag.Ofertas != null)
                            {
                                foreach (var oferta in ViewBag.Ofertas)
                                {
                                    bool preseleccionada = ofertaSeleccionada.HasValue && oferta.IdOferta == ofertaSeleccionada.Value;
                                    <option value="@oferta.IdOferta" selected="@(preseleccionada ? "selected" : null)">
                                        @oferta.NombrePrograma
                                    </option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Cuentanos por que te interesa este programa</label>
                        <textarea name="resumen" class="form-control" rows="4" required placeholder="Motivacion, metas academicas o profesionales..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-portal-primary w-100">Enviar postulacion</button>
                </form>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card-portal p-4">
                <h3 class="h5 mb-2">Consultar cupos aceptados</h3>
                <p class="text-muted small">Revisa cuantos postulantes ya fueron aceptados en un programa.</p>
                <form method="post" action="/Solicitud/RevisarCupos">
                    <div class="mb-3">
                        <label class="form-label">ID del programa (oferta)</label>
                        <input type="number" name="idOfertaCupo" class="form-control" required placeholder="Ej: 101" />
                    </div>
                    <button type="submit" class="btn btn-portal-outline w-100">Consultar</button>
                </form>
            </div>
        </div>
    </div>
</div>
