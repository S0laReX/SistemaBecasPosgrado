@{
    ViewData["Title"] = "Gestión de Becas de Posgrado";
}

<div class="container mt-4">
    <h2>Formulario de Postulación</h2>

    <!-- Mostrar mensajes de éxito o error enviados por el Controlador -->
    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">@TempData["Exito"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row">
        <!-- Columna Izquierda: Formulario de Registro -->
        <div class="col-md-7">
            <div class="card shadow-sm p-4">
                <form method="post" action="/Solicitud/EnviarPostulacion">

                    <div class="mb-3">
                        <label class="form-label">Documento de Identidad:</label>
                        <input type="text" name="docIdentidad" class="form-control" required placeholder="Ej: 1234567" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Seleccione el Programa (Oferta Vigente):</label>
                        <select name="idOferta" class="form-select" required>
                            <option value="">-- Seleccione una opción --</option>
                            @if (ViewBag.Ofertas != null)
                            {
                                foreach (var oferta in ViewBag.Ofertas)
                                {
                                    <option value="@oferta.IdOferta">@oferta.NombrePrograma (ID: @oferta.IdOferta)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Resumen de Interés (Motivación):</label>
                        <textarea name="resumen" class="form-control" rows="4" required></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100">Registrar Solicitud</button>
                </form>
            </div>
        </div>

        <!-- Columna Derecha: Panel de Consulta Rápida -->
        <div class="col-md-5">
            <div class="card shadow-sm p-4 bg-light">
                <form method="post" action="/Solicitud/RevisarCupos">
                    <h4>Revisar Cupos Aceptados</h4>
                    <p class="text-muted small">Consulte cuántos estudiantes ya han sido aceptados en una oferta.</p>

                    <div class="mb-3">
                        <label class="form-label">ID de la Oferta:</label>
                        <input type="number" name="idOfertaCupo" class="form-control" required placeholder="Ej: 101" />
                    </div>

                    <button type="submit" class="btn btn-secondary w-100">Consultar</button>
                </form>
            </div>
        </div>
    </div>
</div>
