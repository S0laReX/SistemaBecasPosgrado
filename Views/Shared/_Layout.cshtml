<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Posgrado</title>
    <!-- Bootstrap 5 para un diseño limpio y moderno -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
            /* Un pequeño ajuste para que la página ocupe todo el alto y el footer quede abajo */
            html, body { height: 100%; }
            body { display: flex; flex-direction: column; }
            .content-flex { flex: 1 0 auto; }
            .footer { flex-shrink: 0; }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/Solicitud/Index">🎓 Becas Posgrado</a>

                <!-- Botón hamburguesa para móviles -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <!-- Módulo Principal (Transacciones PL/SQL) -->
                        <li class="nav-item">
                            <a class="nav-link text-white" href="/Solicitud/Index">Postulaciones</a>
                        </li>

                        <!-- Separador visual -->
                        <li class="nav-item d-none d-lg-block"><span class="nav-link text-secondary">|</span></li>

                        <!-- Catálogos (CRUDs) -->
                        <li class="nav-item">
                            <a class="nav-link" href="/Postulante/Index">Candidatos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Oferta/Index">Ofertas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Programa/Index">Programas</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Universidad/Index">Universidades</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/Sede/Index">Sedes</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Contenedor dinámico donde Razor inyecta las otras vistas -->
    <div class="container content-flex mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Pie de página -->
    <footer class="footer bg-light text-center text-muted py-3 mt-auto shadow-sm">
        <div class="container">
            <small>&copy; 2026 - Sistema de Gestión Académica Objeto-Relacional</small>
        </div>
    </footer>

    <!-- Script de Bootstrap para que funcione el menú desplegable en móviles -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>