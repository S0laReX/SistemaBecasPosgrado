@model List<SistemaBecasWeb.Models.OfertaViewModel>
@{
    ViewData["Title"] = "Becas de Posgrado";
    var universidades = Model.Select(o => o.NombreUniversidad).Where(n => !string.IsNullOrWhiteSpace(n)).Distinct().Count();
}

<section class="portal-hero" aria-labelledby="portal-title">
    <div class="portal-hero-copy">
        <span class="portal-eyebrow">BECAS Y CONVOCATORIAS · BOLIVIA</span>
        <h1 id="portal-title">Tu siguiente paso académico empieza aquí.</h1>
        <p>Encuentra oportunidades de posgrado, compara programas y presenta tu postulación desde un solo lugar.</p>
        <div class="portal-hero-actions">
            <a class="btn portal-button-light" href="#programas">Explorar convocatorias <span aria-hidden="true">→</span></a>
            <a class="btn portal-button-outline" asp-controller="Postulante" asp-action="Crear">Crear mi perfil</a>
        </div>
    </div>
    <aside class="portal-hero-summary" aria-label="Resumen de convocatorias">
        <span class="portal-summary-label">OPORTUNIDADES DISPONIBLES</span>
        <div class="portal-summary-stats">
            <div><strong>@Model.Count</strong><span>convocatorias abiertas</span></div>
            <div><strong>@universidades</strong><span>universidades participantes</span></div>
        </div>
        <p>Explora la oferta vigente y encuentra un programa para avanzar en tu formación.</p>
    </aside>
</section>

<section id="programas" class="portal-programs" aria-labelledby="programas-title">
    <div class="portal-section-heading">
        <div>
            <span class="eyebrow">OFERTA ACADÉMICA VIGENTE</span>
            <h2 id="programas-title">Programas con convocatoria abierta</h2>
            <p>Revisa las condiciones de cada programa y elige dónde quieres postularte.</p>
        </div>
        <span class="portal-result-count">@Model.Count @(Model.Count == 1 ? "convocatoria" : "convocatorias")</span>
    </div>

    @if (Model.Count == 0)
    {
        <div class="portal-empty-state">
            <span class="portal-empty-symbol" aria-hidden="true">✦</span>
            <h3>No hay convocatorias abiertas por ahora</h3>
            <p>Puedes crear tu perfil y volver a consultar cuando se publiquen nuevas oportunidades.</p>
            <a class="btn btn-primary" asp-controller="Postulante" asp-action="Crear">Crear mi perfil</a>
        </div>
    }
    else
    {
        <div class="portal-program-grid">
            @foreach (var oferta in Model)
            {
                var tipoClase = (oferta.TipoPrograma ?? "").ToLowerInvariant() switch
                {
                    var t when t.Contains("doctorado") => "portal-type-doctorado",
                    var t when t.Contains("especialidad") => "portal-type-especialidad",
                    _ => "portal-type-maestria"
                };

                <article class="portal-program-card">
                    <div class="portal-card-top">
                        <span class="portal-university">@oferta.NombreUniversidad</span>
                        <span class="portal-program-type @tipoClase">@oferta.TipoPrograma</span>
                    </div>
                    <h3>@oferta.NombrePrograma</h3>
                    <dl class="portal-program-facts">
                        <div><dt>Área</dt><dd>@(string.IsNullOrWhiteSpace(oferta.Area) ? "No especificada" : oferta.Area)</dd></div>
                        <div><dt>Modalidad</dt><dd>@(string.IsNullOrWhiteSpace(oferta.Modalidad) ? "No especificada" : oferta.Modalidad)</dd></div>
                        <div><dt>Financiamiento</dt><dd>@(string.IsNullOrWhiteSpace(oferta.TipoFinanciamiento) ? "Consultar" : oferta.TipoFinanciamiento)</dd></div>
                    </dl>
                    <div class="portal-card-footer">
                        <div><span>Cierre de postulación</span><strong>@oferta.FechaFin.ToString("dd/MM/yyyy")</strong></div>
                        <a class="portal-card-link" asp-controller="Solicitud" asp-action="Index" asp-route-idOferta="@oferta.IdOferta" aria-label="Postularme a @oferta.NombrePrograma">Postularme <span aria-hidden="true">→</span></a>
                    </div>
                </article>
            }
        </div>
    }
</section>
